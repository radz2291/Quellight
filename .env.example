# Quellight protected operator configuration — VARIABLE NAMES ONLY.
#
# This file documents the configuration surface. It NEVER carries values.
# Copy to `.env` locally and fill values in your own environment; `.env`
# is git-ignored and must never be committed.
#
# Quellight resolves provider credentials ONLY through the VICT protected
# operator-configuration foundation: credential VALUES are never logged,
# serialized, persisted, embedded in build artifacts, or echoed in errors.

# ── Provider profile ────────────────────────────────────────────────────────
# The ONE pinned Stage 07B provider profile (closed value; no rotation, no
# fallback). Accepted value: ollama-cloud/glm-5.3-flash
QUELLIGHT_PROFILE=ollama-cloud/glm-5.3-flash

# ── Provider credential ─────────────────────────────────────────────────────
# Ollama Cloud API key. Resolved just in time through the protected
# credential boundary (VICT_OPERATOR_CREDENTIAL_UNAVAILABLE when absent).
# Supply this directly in your implementation environment. Never commit it,
# never paste it into chat, source, or reports.
OLLAMA_API_KEY=

# ── Local actor boundary ────────────────────────────────────────────────────
# Bearer token for the loopback VICT boundary; injected server-side by the
# /vict proxy. The browser never holds it. When absent, the dev composition
# generates an ephemeral in-process token (never logged or persisted).
QUELLIGHT_ACTOR_TOKEN=

# ── Storage and retention ───────────────────────────────────────────────────
# Data directory for all store files (bounded relative path; never a URL,
# absolute path, or publicly served directory). Default: .quellight-data
QUELLIGHT_DATA_DIR=.quellight-data

# Mastra-side retention bounds (positive integer milliseconds).
QUELLIGHT_RETENTION_MESSAGES_MAX_AGE_MS=
QUELLIGHT_RETENTION_THREADS_MAX_AGE_MS=
QUELLIGHT_RETENTION_SPANS_MAX_AGE_MS=

# ── Runtime ─────────────────────────────────────────────────────────────────
# Public port for the SvelteKit host. Default: 5173 (dev) / 4173 (preview).
QUELLIGHT_PORT=

# Bounded turn deadline in milliseconds (operator-visible; expiry settles
# the turn honestly with a stable safe code). Default: 120000.
QUELLIGHT_TURN_DEADLINE_MS=

# ── Bounded live proof gate ─────────────────────────────────────────────────
# Live-provider proof opt-in. Absence (or any value other than 1) keeps the
# system fully offline. Never set in CI; never part of npm test.
QUELLIGHT_LIVE_PROOF=
